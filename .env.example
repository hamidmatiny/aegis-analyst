# AEGIS Analyst Configuration
# Copy this to .env and fill in your values

# Trinity connection is NOT configured here — the platform injects it.
# (/trinity:connect keeps local credentials in ~/.trinity/config.json + .mcp.json;
#  a deployed agent gets its `trinity` MCP entry written by the container at startup.)

# Read-only, GET-only bearer token for corp-orchestrator's /api/corp/v1/bev/* endpoints
# at https://defenseaegis.org — the same credential aegis-ceo uses.
# NEVER put AEGIS_INTERNAL_TOKEN or any admin/write credential here.
CORP_READONLY_TOKEN=
